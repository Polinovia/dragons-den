generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum StoryStatus {
  DRAFT
  ONGOING
  COMPLETED
}

enum ContributorRole {
  OWNER
  CONTRIBUTOR
}

enum ContentType {
  SKETCH
  STORY
  THOUGHT
}

enum CollectionItemType {
  SKETCH
  STORY
  THOUGHT
  NOTE
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  COMMENT
  LIKE
  CONTINUATION
  CONTRIBUTOR_ADDED
  CHAPTER_PUBLISHED
}

model User {
  id           String   @id @default(cuid(2))
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile?

  sketches                Sketch[]
  thoughts                Thought[]
  authoredStories         Story[]                 @relation("StoryAuthor")
  storyContributions      StoryContributor[]
  chapters                Chapter[]
  ownedCollections        Collection[]            @relation("CollectionOwner")
  collectionContributions CollectionContributor[]
  addedCollectionItems    CollectionItem[]        @relation("CollectionItemAddedBy")

  comments Comment[]
  likes    Like[]

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  notifications       Notification[] @relation("NotificationRecipient")
  notificationsCaused Notification[] @relation("NotificationActor")

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid(2))
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  avatarUrl   String   @default("/avatars/default.svg")
  pronouns    String?
  location    String?
  locale      String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

model Friendship {
  id          String           @id @default(cuid(2))
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

model Sketch {
  id                 String     @id @default(cuid(2))
  title              String?
  body               String
  authorId           String
  author             User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId           String?
  parent             Sketch?    @relation("SketchContinuations", fields: [parentId], references: [id], onDelete: SetNull)
  continuations      Sketch[]   @relation("SketchContinuations")
  visibility         Visibility @default(PRIVATE)
  allowComments      Boolean    @default(true)
  allowLikes         Boolean    @default(true)
  allowContinuations Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  comments        Comment[]
  likes           Like[]
  tags            ContentTag[]
  collectionItems CollectionItem[]

  @@index([authorId, visibility])
  @@index([parentId])
  @@map("sketches")
}

model Story {
  id                 String      @id @default(cuid(2))
  slug               String      @unique
  title              String
  synopsis           String?
  status             StoryStatus @default(DRAFT)
  visibility         Visibility  @default(PRIVATE)
  allowComments      Boolean     @default(true)
  allowLikes         Boolean     @default(true)
  allowContributions Boolean     @default(false)
  authorId           String
  author             User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  chapters        Chapter[]
  contributors    StoryContributor[]
  comments        Comment[]
  likes           Like[]
  tags            ContentTag[]
  collectionItems CollectionItem[]

  @@index([authorId, visibility])
  @@map("stories")
}

model StoryContributor {
  id        String          @id @default(cuid(2))
  storyId   String
  story     Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ContributorRole @default(CONTRIBUTOR)
  createdAt DateTime        @default(now())

  @@unique([storyId, userId])
  @@map("story_contributors")
}

model Chapter {
  id          String   @id @default(cuid(2))
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  slug        String
  title       String
  body        String
  order       Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storyId, order])
  @@unique([storyId, slug])
  @@map("chapters")
}

model Thought {
  id            String     @id @default(cuid(2))
  body          String
  authorId      String
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  visibility    Visibility @default(FRIENDS)
  allowComments Boolean    @default(true)
  allowLikes    Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  comments        Comment[]
  likes           Like[]
  tags            ContentTag[]
  collectionItems CollectionItem[]

  @@index([authorId, visibility])
  @@map("thoughts")
}

model Collection {
  id          String     @id @default(cuid(2))
  name        String
  description String?
  visibility  Visibility @default(PRIVATE)
  ownerId     String
  owner       User       @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contributors CollectionContributor[]
  items        CollectionItem[]

  @@index([ownerId, visibility])
  @@map("collections")
}

model CollectionContributor {
  id           String          @id @default(cuid(2))
  collectionId String
  collection   Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         ContributorRole @default(CONTRIBUTOR)
  createdAt    DateTime        @default(now())

  @@unique([collectionId, userId])
  @@map("collection_contributors")
}

model CollectionItem {
  id           String             @id @default(cuid(2))
  collectionId String
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  itemType     CollectionItemType
  sketchId     String?
  sketch       Sketch?            @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  storyId      String?
  story        Story?             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  thoughtId    String?
  thought      Thought?           @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  noteTitle    String?
  noteBody     String?
  order        Int                @default(0)
  addedById    String
  addedBy      User               @relation("CollectionItemAddedBy", fields: [addedById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([collectionId, order])
  @@index([sketchId])
  @@index([storyId])
  @@index([thoughtId])
  @@map("collection_items")
}

model Tag {
  id   String @id @default(cuid(2))
  name String @unique
  slug String @unique

  contentTags ContentTag[]

  @@map("tags")
}

model ContentTag {
  id          String      @id @default(cuid(2))
  tagId       String
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  contentType ContentType
  sketchId    String?
  sketch      Sketch?     @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  storyId     String?
  story       Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  thoughtId   String?
  thought     Thought?    @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  @@unique([tagId, sketchId])
  @@unique([tagId, storyId])
  @@unique([tagId, thoughtId])
  @@map("content_tags")
}

model Comment {
  id          String      @id @default(cuid(2))
  body        String
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  contentType ContentType
  sketchId    String?
  sketch      Sketch?     @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  storyId     String?
  story       Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  thoughtId   String?
  thought     Thought?    @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Comment[]   @relation("CommentReplies")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sketchId])
  @@index([storyId])
  @@index([thoughtId])
  @@map("comments")
}

model Like {
  id          String      @id @default(cuid(2))
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType ContentType
  sketchId    String?
  sketch      Sketch?     @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  storyId     String?
  story       Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  thoughtId   String?
  thought     Thought?    @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([userId, sketchId])
  @@unique([userId, storyId])
  @@unique([userId, thoughtId])
  @@map("likes")
}

model RateLimitAttempt {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@map("rate_limit_attempts")
}

model Notification {
  id          String           @id @default(cuid(2))
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  message     String
  link        String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

DATABASE_URL="postgresql://writer:writer@localhost:5433/writer?schema=public"
# Only needed as a separate value when DATABASE_URL points at a pooled
# connection (e.g. Neon's `-pooler` host in production) — Prisma migrations
# need a direct connection. For local Docker Postgres, same value as above.
DIRECT_URL="postgresql://writer:writer@localhost:5433/writer?schema=public"

AUTH_SECRET="replace-with-openssl-rand-base64-32"
